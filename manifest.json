{
  "manifest_version": 3,
  "name": "UH QuickLinks",
  "version": "1.0.0",
  "description": "Quick links to all the main UH portals in one place. Search them, pin your favorites, and drag them into whatever order you want.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "UH QuickLinks",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage", "favicon"],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Alt+Shift+U"
      },
      "description": "Open UH QuickLinks"
    }
  }
}
